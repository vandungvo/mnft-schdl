@startuml
left to right direction
skinparam packageStyle rectangle

actor "Học viên" as Learner
actor "Vận hành" as Support
actor "Dịch vụ gửi email" as Email

rectangle "System: authentication" {
  usecase "Đăng ký bằng email" as UC1
  usecase "Xác nhận email" as UC2
  usecase "Đăng nhập" as UC3
  usecase "Quên mật khẩu" as UC4
}

Learner -- UC1
Learner -- UC3
Learner -- UC4
Support -- UC3
UC1 -- Email
UC2 -- Email

UC1 ..> UC2 : <<include>>
UC4 ..> UC3 : <<extend>>
@enduml
