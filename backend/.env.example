MNFT_ENVIRONMENT=development
MNFT_DATABASE_URL=sqlite:///./data/mnft.db
MNFT_DATABASE_AUTO_CREATE=true
MNFT_BOOTSTRAP_STANDARD_DATA=true
MNFT_STANDARD_DATA_PATH=models/input/wheel_factory.json
MNFT_API_PREFIX=/api/v1
MNFT_CORS_ORIGINS=["http://localhost:3000"]
MNFT_SOLVER_MAX_CONCURRENT_JOBS=1
MNFT_SOLVER_DEFAULT_BUDGET_SECONDS=30
MNFT_SOLVER_MAX_BUDGET_SECONDS=900
MNFT_RUN_JOBS_INLINE=false
# Required in production. Use different random values of at least 24 characters.
MNFT_OPERATOR_API_KEY=
MNFT_READER_API_KEY=
MNFT_MAX_REQUEST_BODY_BYTES=6291456
